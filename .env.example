NODE_ENV=development
PORT=3000
API_PREFIX=api

DATABASE_URL=postgresql://abraj:abraj_dev_password@localhost:5432/abraj_al_yasir_tasks?schema=public

# --- JWT signing keys (RS256) ---
# Local/dev: generate a keypair with `bash scripts/generate-jwt-keys.sh` and
# leave the *_PATH vars below pointing at it.
JWT_ACCESS_PRIVATE_KEY_PATH=./keys/access-private.pem
JWT_ACCESS_PUBLIC_KEY_PATH=./keys/access-public.pem
#
# Production (Railway, Render, or anywhere without a mounted keys/ volume):
# set these two instead — generate-jwt-keys.sh prints ready-to-paste values.
# Whichever *_BASE64 var is set always wins; the *_PATH vars above are only
# ever read when NODE_ENV is not "production".
# JWT_ACCESS_PRIVATE_KEY_BASE64=
# JWT_ACCESS_PUBLIC_KEY_BASE64=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

CORS_ORIGIN=http://localhost:5173

# Either REDIS_URL (wins when set — Railway: ${{Redis.REDIS_URL}}) or the separate vars below.
# REDIS_URL=redis://default:password@host:6379   (rediss:// = TLS, e.g. Upstash)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=

THROTTLE_TTL=60
THROTTLE_LIMIT=20
AUTH_THROTTLE_LIMIT=5

# --- First-deploy seed data ---
# Overrides the seeded System Owner's credentials. Defaults to
# owner@abrajalyasser.iq / ChangeMe123! if left unset — always set a real
# password here before sharing a production deployment.
# SYSTEM_OWNER_EMAIL=
# SYSTEM_OWNER_PASSWORD=

# --- Demo organisation (QA / showcasing only — NEVER in production) ---
# Seeds fictional departments, 13 demo logins (one per role), staff, units,
# bookings with installments, site reports, tickets, leaves and a payroll draft.
# SEED_DEMO_DATA=true
# DEMO_PASSWORD=Demo@2026!
